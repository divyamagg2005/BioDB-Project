# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# Local configuration and secrets
.env
.env.*
!.env.example

# Generated and potentially large project data
data/raw/*
data/processed/*
data/final/*
models/*
results/figures/*
results/metrics/*

# Small derived phase outputs are versioned for review and reproducibility
!data/processed/phase*/
!results/metrics/folds.csv
!results/metrics/phase*/
!results/figures/phase*/
!models/phase*/
# Random forest models are large (~14 MB each) and quick to refit
models/**/*random_forest*.joblib

# Keep directory placeholders in version control
!.gitkeep
